APP_NAME="Winmap Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=winmap_admin
DB_USERNAME=winmap
DB_PASSWORD=winmap

WINMAP_ADMIN_DB_DATABASE=winmap_admin
WINMAP_ADMIN_DB_USERNAME=winmap
WINMAP_ADMIN_DB_PASSWORD=winmap

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
REDIS_CLIENT=phpredis

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@winmap.local
ADMIN_PASSWORD=change-this-password

DRUPAL_DISCOVERY_ROOTS="/workspace/winmap_new"
DRUPAL_AUTH_SITE_KEY="enter.winmap.vn"
DRUPAL_AUTH_SETTINGS_PATH=
WINMAP_ADMIN_DRUPAL_DISCOVERY_ROOTS="/workspace/winmap_new"
WINMAP_ADMIN_DRUPAL_AUTH_PASSWORD_INC_PATH="/workspace/winmap_new/includes/password.inc"

# Dung khi settings.php cua Drupal tro DB ve localhost va container app khong truy cap duoc.
DRUPAL_AUTH_DB_HOST=
DRUPAL_AUTH_DB_PORT=3306
DRUPAL_AUTH_DB_DATABASE=
DRUPAL_AUTH_DB_USERNAME=
DRUPAL_AUTH_DB_PASSWORD=
DRUPAL_AUTH_DB_PREFIX=
DRUPAL_AUTH_PASSWORD_INC_PATH="/workspace/winmap_new/includes/password.inc"

DEFAULT_WARNING_THRESHOLD_PERCENT=85

SERVER_USAGE_PATH=/
TERMINAL_ENABLED=true
TERMINAL_TIMEOUT=12
TERMINAL_MAX_OUTPUT_BYTES=60000
TERMINAL_ALLOWED_COMMANDS=pwd,ls,df,du,uptime,whoami,date
TERMINAL_ALLOWED_ROOTS="/var/www/html|/workspace/winmap_new"
WINMAP_ADMIN_TERMINAL_ALLOWED_ROOTS="/var/www/html|/workspace/winmap_new"

APP_PORT=8088
MYSQL_ROOT_PASSWORD=root
MYSQL_FORWARD_PORT=33067
